{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "status": {
      "type": "string",
      "enum": ["PASS", "FAIL"]
    },
    "summary": {
      "type": "string"
    },
    "blocking_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "priority": {
            "type": "string",
            "enum": ["P0", "P1", "P2"]
          },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "path": { "type": ["string", "null"] }
        },
        "required": ["id", "priority", "title", "description", "path"]
      }
    },
    "follow_ups": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "required": ["status", "summary", "blocking_findings", "follow_ups"]
}
